# Single tenant/blueprint lab. The secret VALUE belongs to the blueprint.
TENANT_ID=11111111-1111-4111-8111-111111111111
CLIENT_ID=22222222-2222-4222-8222-222222222222
CLIENT_SECRET=replace-with-blueprint-secret-value
LAB_AGENTS_FILE=./agents.local.json
# Comma-separated human tester Entra object IDs, not UPNs.
LAB_TESTER_IDS=66666666-6666-4666-8666-666666666666
PORT=3978
# Echo/identity work without Graph. Enable only after granting scoped consent.
LAB_GRAPH_ENABLED=false
LAB_MAILBOX_ENABLED=false
